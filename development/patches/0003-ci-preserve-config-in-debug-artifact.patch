From b956a4d6ec2bf535c44d127d9adda245a641a8aa Mon Sep 17 00:00:00 2001
From: skeler <salahlsxusa@gmail.com>
Date: Mon, 27 Jul 2026 01:15:13 +0100
Subject: [PATCH 3/4] ci: preserve config in debug artifact

---
 .github/workflows/build.yml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index cc331a393..47c141a3a 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -148,7 +148,8 @@ jobs:
           cp "${oneui_tars[0]}" "${aosp_tars[0]}" artifact/odin/
           cp out/arch/arm64/boot/Image artifact/debug/
           cp out/arch/arm64/boot/dts/exynos/exynos2100.dtb artifact/debug/
-          cp out/.config log.txt artifact/debug/
+          cp out/.config artifact/debug/config
+          cp log.txt artifact/debug/
           git rev-parse HEAD > artifact/debug/commit.txt
 
           (
@@ -156,8 +157,7 @@ jobs:
             sha256sum \
               flashable/*.zip \
               odin/*.tar \
-              debug/Image \
-              debug/exynos2100.dtb > SHA256SUMS
+              debug/* > SHA256SUMS
           )
 
           short_sha="${GITHUB_SHA::7}"
